---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import TocSidebar from '../components/TocSidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import FeatureCard from '../components/FeatureCard.astro';
import SuggestedFeatures from '../components/SuggestedFeatures.astro';
import StackTable from '../components/StackTable.astro';
import Footer from '../components/Footer.astro';
import { TOC } from '../data/toc';
import { FEATURES, LANDING_STACK, TECHCART_STACK } from '../data/techcart';

// Sections handled here in #3; the rest stay stubbed for #4 (claude-code…env-vars)
// and #5 (api-debugging…git-github).
const handled = ['hero', 'summary', 'features', 'suggested-features', 'tech-stack', 'get-started'];
const guideStubs = TOC.filter((entry) => !handled.includes(entry.id));
---

<BaseLayout>
  <Nav />

  <div class="mx-auto max-w-6xl px-4 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
    <TocSidebar />

    <div class="min-w-0">
      <MobileNav />

      <Hero />

      <Section id="summary" title="Project Summary">
        <ProjectSummary />
      </Section>

      <Section id="features" title="Features">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {FEATURES.map((feature) => (
            <FeatureCard feature={feature} />
          ))}
        </div>
      </Section>

      <Section id="suggested-features" title="Suggested Features">
        <SuggestedFeatures />
      </Section>

      <Section id="tech-stack" title="Tech Stack">
        <StackTable
          caption="This landing page"
          head={['Concern', 'Choice', 'Why']}
          rows={LANDING_STACK}
        />
        <StackTable caption="TechCart" head={['Layer', 'Technology']} rows={TECHCART_STACK} />
      </Section>

      {guideStubs.map((entry) => (
        <Section id={entry.id} title={entry.title}>
          <p class="text-muted">
            Placeholder for &ldquo;{entry.title}&rdquo;. Real content lands in issues #4&ndash;#5.
          </p>
        </Section>
      ))}

      <Section id="get-started" title="Get Started">
        <Footer />
      </Section>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/scrollspy.ts';
</script>
