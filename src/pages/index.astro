---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import TocSidebar from '../components/TocSidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import ProjectSummary from '../components/ProjectSummary.astro';
import FeatureCard from '../components/FeatureCard.astro';
import SuggestedFeatures from '../components/SuggestedFeatures.astro';
import StackTable from '../components/StackTable.astro';
import ClaudeCode from '../components/ClaudeCode.astro';
import FolderArchitecture from '../components/FolderArchitecture.astro';
import NodeVersion from '../components/NodeVersion.astro';
import EnvVars from '../components/EnvVars.astro';
import ApiDebugging from '../components/ApiDebugging.astro';
import EslintPrettierLockfile from '../components/EslintPrettierLockfile.astro';
import CiCd from '../components/CiCd.astro';
import Deployment from '../components/Deployment.astro';
import ApiDesign from '../components/ApiDesign.astro';
import GitGithub from '../components/GitGithub.astro';
import Footer from '../components/Footer.astro';
import { FEATURES, LANDING_STACK, TECHCART_STACK } from '../data/techcart';
---

<BaseLayout>
  <Nav />

  <div class="mx-auto max-w-6xl px-4 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12">
    <TocSidebar />

    <div class="min-w-0">
      <MobileNav />

      <Hero />

      <Section id="summary" title="Project Summary">
        <ProjectSummary />
      </Section>

      <Section id="features" title="Features">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {FEATURES.map((feature) => (
            <FeatureCard feature={feature} />
          ))}
        </div>
      </Section>

      <Section id="suggested-features" title="Suggested Features">
        <SuggestedFeatures />
      </Section>

      <Section id="tech-stack" title="Tech Stack">
        <StackTable
          caption="This landing page"
          head={['Concern', 'Choice', 'Why']}
          rows={LANDING_STACK}
        />
        <StackTable caption="TechCart" head={['Layer', 'Technology']} rows={TECHCART_STACK} />
      </Section>

      <Section id="claude-code" title="How to Handle Claude Code">
        <ClaudeCode />
      </Section>

      <Section id="folder-architecture" title="Folder Architecture">
        <FolderArchitecture />
      </Section>

      <Section id="node-version" title=".node-version & .nvmrc">
        <NodeVersion />
      </Section>

      <Section id="env-vars" title="Environment Variables">
        <EnvVars />
      </Section>

      <Section id="api-debugging" title="Frontend API Debugging">
        <ApiDebugging />
      </Section>

      <Section id="eslint-prettier-lockfile" title="ESLint, Prettier & package-lock">
        <EslintPrettierLockfile />
      </Section>

      <Section id="ci-cd" title="CI & CD Pipelines">
        <CiCd />
      </Section>

      <Section id="deployment" title="Deployment">
        <Deployment />
      </Section>

      <Section id="api-design" title="API Design & Documentation">
        <ApiDesign />
      </Section>

      <Section id="git-github" title="Git, GitHub & GitHub Actions">
        <GitGithub />
      </Section>

      <Section id="get-started" title="Get Started">
        <Footer />
      </Section>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/scrollspy.ts';
</script>
