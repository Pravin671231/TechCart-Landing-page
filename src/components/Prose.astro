---
/**
 * Typographic wrapper for long-form copy (issues #4 / #5). Keeps a readable
 * measure and consistent rhythm without pulling in @tailwindcss/typography.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={[
    'prose-block max-w-[65ch] text-[0.975rem] leading-7 text-fg/90',
    '[&_p]:my-4 [&_ul]:my-4 [&_ol]:my-4 [&_li]:my-1',
    '[&_ul]:list-disc [&_ol]:list-decimal [&_ul]:pl-6 [&_ol]:pl-6',
    '[&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-fg',
    '[&_h4]:mt-6 [&_h4]:mb-2 [&_h4]:font-semibold [&_h4]:text-fg',
    '[&_a]:font-medium [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2',
    // Inline code only — never the <code> inside a CodeBlock's <pre>.
    '[&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-surface [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:font-mono [&_:not(pre)>code]:text-[0.85em]',
    '[&_strong]:font-semibold [&_strong]:text-fg',
    className,
  ]}
>
  <slot />
</div>
