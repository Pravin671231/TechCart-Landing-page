---
import { SUGGESTED } from '../data/techcart';
---

<div class="grid gap-6 md:grid-cols-2">
  <div class="rounded-lg border border-border bg-surface p-5">
    <h3 class="text-sm font-semibold tracking-widest text-muted uppercase">In flight</h3>
    <p class="mt-1 text-xs text-muted">Open milestones on the TechCart roadmap.</p>
    <ul class="mt-4 space-y-4">
      {SUGGESTED.inFlight.map((item) => (
        <li>
          <span class="inline-block rounded-full bg-accent/10 px-2 py-0.5 text-xs font-semibold text-accent">
            {item.milestone}
          </span>
          <p class="mt-1.5 text-sm leading-6 text-muted">{item.scope}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="rounded-lg border border-border bg-surface p-5">
    <h3 class="text-sm font-semibold tracking-widest text-muted uppercase">Ideas</h3>
    <p class="mt-1 text-xs text-muted">Not yet specced — candidates for future milestones.</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {SUGGESTED.ideas.map((idea) => (
        <li class="rounded-full border border-border px-3 py-1 text-xs text-fg">{idea}</li>
      ))}
    </ul>
  </div>
</div>
