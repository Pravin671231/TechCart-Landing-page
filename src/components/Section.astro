---
interface Props {
  /** DOM id + anchor target (from src/data/toc.ts). */
  id: string;
  /** Section heading. */
  title: string;
  /** Optional small label above the heading. */
  eyebrow?: string;
}

const { id, title, eyebrow } = Astro.props;
---

<section
  id={id}
  tabindex="-1"
  class="section-enter scroll-mt-20 border-b border-border py-14 first:pt-8 last:border-0 md:py-20"
>
  {eyebrow && (
    <p class="mb-2 text-xs font-medium tracking-widest text-muted uppercase">{eyebrow}</p>
  )}
  <h2 class="text-2xl font-semibold tracking-tight text-fg md:text-3xl">{title}</h2>
  <div class="mt-6">
    <slot />
  </div>
</section>
