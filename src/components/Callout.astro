---
type CalloutType = 'note' | 'tip' | 'warning';

interface Props {
  type?: CalloutType;
  /** Optional heading; defaults to a label for the type. */
  title?: string;
}

const { type = 'note', title } = Astro.props;

const styles: Record<CalloutType, { border: string; badge: string; label: string }> = {
  note: { border: 'border-sky-500', badge: 'text-sky-600 dark:text-sky-400', label: 'Note' },
  tip: {
    border: 'border-emerald-500',
    badge: 'text-emerald-600 dark:text-emerald-400',
    label: 'Tip',
  },
  warning: {
    border: 'border-amber-500',
    badge: 'text-amber-600 dark:text-amber-400',
    label: 'Warning',
  },
};

const { border, badge, label } = styles[type];
const icons: Record<CalloutType, string> = {
  note: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  tip: 'M9 21h6m-3-3v3m-5.5-8a5.5 5.5 0 1111 0c0 2-1 3-2 4H8.5c-1-1-2-2-2-4z',
  warning:
    'M12 9v4m0 4h.01M10.29 3.86l-8.4 14.55A1.5 1.5 0 003.19 21h17.62a1.5 1.5 0 001.3-2.59L13.7 3.86a1.5 1.5 0 00-2.6 0z',
};
---

<div class:list={['my-5 rounded-r-md border-l-4 bg-surface p-4', border]}>
  <p class:list={['mb-1 flex items-center gap-1.5 text-sm font-semibold', badge]}>
    <svg
      class="h-4 w-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={icons[type]}></path>
    </svg>
    {title ?? label}
  </p>
  <div class="text-sm leading-6 text-fg/90 [&_a]:text-accent [&_a]:underline [&_code]:font-mono">
    <slot />
  </div>
</div>
