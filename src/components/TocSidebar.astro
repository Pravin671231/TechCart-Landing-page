---
import { TOC } from '../data/toc';
---

<nav aria-label="On this page" class="hidden lg:block">
  <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto py-10">
    <p class="mb-3 text-xs font-semibold tracking-widest text-muted uppercase">On this page</p>
    <ol class="space-y-1 text-sm">
      {TOC.map((entry) => (
        <li>
          <a
            href={`#${entry.id}`}
            data-toc-link={entry.id}
            class="toc-link block border-l-2 border-transparent py-1 pl-3 text-muted transition-colors hover:text-fg"
          >
            {entry.title}
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .toc-link.is-active {
    border-color: var(--accent);
    color: var(--fg);
    font-weight: 500;
  }
</style>
