---
import { TECHCART_REPO_URL } from '../consts';
import { MILESTONES_SHIPPED, MILESTONES_TOTAL } from '../data/techcart';

const stats = [
  { value: '3', label: 'workspaces' },
  { value: `${MILESTONES_SHIPPED} of ${MILESTONES_TOTAL}`, label: 'milestones shipped' },
  { value: 'Node 24', label: 'pinned everywhere' },
  { value: 'Razorpay', label: 'India-first payments' },
];
---

<section
  id="hero"
  tabindex="-1"
  class="section-enter scroll-mt-20 -mx-4 rounded-b-2xl bg-gradient-to-br from-accent/10 via-transparent to-accent-2/10 px-4 py-16 md:py-24"
>
  <p class="text-xs font-medium tracking-widest text-muted uppercase">
    Production e-commerce platform
  </p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-fg md:text-5xl">
    Tech
    <span class="bg-gradient-to-r from-accent to-accent-2 bg-clip-text text-transparent">Cart</span>
  </h1>
  <p class="mt-4 max-w-2xl text-lg text-muted">
    An India-first e-commerce platform — a Next.js storefront and a React admin console sharing one
    Express API and one MongoDB database, on managed infrastructure only.
  </p>

  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href={TECHCART_REPO_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition-opacity hover:opacity-90"
    >
      View on GitHub
    </a>
    <a
      href="#summary"
      class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:bg-surface"
    >
      Read the guide
    </a>
  </div>

  <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {stats.map((stat) => (
      <div class="rounded-lg border border-border bg-page/60 p-3">
        <dt class="text-lg font-semibold text-fg">{stat.value}</dt>
        <dd class="text-xs text-muted">{stat.label}</dd>
      </div>
    ))}
  </dl>
</section>
