---
import type { StackRow } from '../data/techcart';

interface Props {
  caption: string;
  head: [string, string] | [string, string, string];
  rows: readonly StackRow[];
}

const { caption, head, rows } = Astro.props;
const hasThird = head.length === 3;
---

<figure class="mt-4 first:mt-0">
  <figcaption class="mb-2 text-sm font-semibold text-fg">{caption}</figcaption>
  <div class="overflow-x-auto rounded-lg border border-border">
    <table class="w-full border-collapse text-left text-sm">
      <thead class="bg-surface text-xs tracking-wide text-muted uppercase">
        <tr>
          <th class="px-4 py-2 font-medium">{head[0]}</th>
          <th class="px-4 py-2 font-medium">{head[1]}</th>
          {hasThird && <th class="px-4 py-2 font-medium">{head[2]}</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-t border-border align-top">
            <td class="px-4 py-2 font-medium whitespace-nowrap text-fg">{row.a}</td>
            <td class="px-4 py-2 text-muted">{row.b}</td>
            {hasThird && <td class="px-4 py-2 text-muted">{row.c}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
