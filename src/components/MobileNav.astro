---
import { TOC } from '../data/toc';
---

<details class="mobile-nav mt-4 rounded-lg border border-border bg-surface lg:hidden">
  <summary class="cursor-pointer list-none px-4 py-3 text-sm font-semibold text-fg select-none [&::-webkit-details-marker]:hidden">
    <span class="flex items-center justify-between">
      On this page
      <svg
        class="chevron h-4 w-4 text-muted transition-transform"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </span>
  </summary>
  <ol class="border-t border-border px-2 py-2 text-sm">
    {TOC.map((entry) => (
      <li>
        <a
          href={`#${entry.id}`}
          data-toc-link={entry.id}
          class="toc-link block rounded px-2 py-1.5 text-muted transition-colors hover:text-fg"
        >
          {entry.title}
        </a>
      </li>
    ))}
  </ol>
</details>

<style>
  .mobile-nav[open] .chevron {
    transform: rotate(180deg);
  }
  .toc-link.is-active {
    color: var(--fg);
    font-weight: 500;
  }
</style>

<script>
  // Collapse the disclosure after picking a destination.
  const details = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  details?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      details.open = false;
    });
  });
</script>
