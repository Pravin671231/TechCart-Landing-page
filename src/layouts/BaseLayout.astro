---
import '../styles/global.css';
import '@fontsource-variable/inter';
import BrandTokens from '../components/BrandTokens.astro';
import { SITE_TITLE, SITE_DESCRIPTION, TECHCART_REPO_URL } from '../consts';

interface Props {
  /** Page title; falls back to the site title. */
  title?: string;
  /** Meta description; falls back to the site description. */
  description?: string;
  /** Path (relative to origin) for the OG image. */
  image?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = '/og.png' } = Astro.props;

// Astro.site is set in astro.config.mjs; fall back to the current origin in dev.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageURL = new URL(image, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* Apply a stored theme choice before first paint to avoid a flash. */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        /* no stored preference; fall back to the OS setting */
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#CAF0F8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#03045E" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TechCart" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <BrandTokens />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-4 py-8 text-xs text-muted">
      <p>
        Built with Astro and Tailwind CSS, deployed on Vercel. It presents the public
        <a
          href={TECHCART_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent underline underline-offset-2"
        >
          TechCart
        </a>
        repository — every fact traces to its README, architecture doc, and CI workflow.
      </p>
    </footer>
  </body>
</html>
